{
  "manifest_version": 3,
  "name": "ContinueO Auto Login",
  "version": "1.0.2",
  "description": "Automated two-step login extension for ContinueO parent portal (BMSIT&M) on Windows desktop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ContinueO Auto Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://student.bmsit.ac.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://student.bmsit.ac.in/*"
      ],
      "js": [
        "common/constants.js",
        "common/crypto.js",
        "common/storage.js",
        "content/contineo-selectors.js",
        "content/contineo-adapter.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
